# Copy to .env.local for local dev. On Render, set these as environment variables (never commit real values).

# PayPal (sandbox): developer.paypal.com > Apps & Credentials > Sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox
NEXT_PUBLIC_PAYPAL_CLIENT_ID=

# Secret for server-only actions (charge or cancel a hold). Any long random string.
ADMIN_API_KEY=

# LLM for the concierge agent
ANTHROPIC_API_KEY=
# Optional: override the model (default claude-sonnet-5-5)
CONCIERGE_MODEL=

# Database (Render Postgres)
DATABASE_URL=

# Optional
CHANNEL3_API_KEY=
# Live venue search anywhere, photos and venue descriptions. Places API (New), restricted key.
GOOGLE_PLACES_API_KEY=
# Concerts and shows: developer.ticketmaster.com (Consumer Key)
TICKETMASTER_API_KEY=
# Optional model overrides for price lookups and venue descriptions (default: CONCIERGE_MODEL)
PRICING_MODEL=
ABOUT_MODEL=
